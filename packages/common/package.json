{
  "name": "@zajno/common",
  "version": "3.2.0",
  "description": "Zajno's re-usable utilities for JS/TS projects",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idudinov/common-utils.git",
    "directory": "packages/common"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "author": "Zajno <hello@zajno.com> (https://zajno.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/idudinov/common-utils/issues"
  },
  "homepage": "https://github.com/idudinov/common-utils/tree/main/packages/common#readme",
  "scripts": {
    "clean": "task clean",
    "dev": "task dev",
    "build": "task build",
    "build:clean": "task build:clean",
    "build:full": "task build:full",
    "bundle": "task bundle",
    "update-exports": "task update-exports",
    "lint": "task lint",
    "test": "task test",
    "check": "task check",
    "check:publish": "task check:publish",
    "publish:local": "task publish:local",
    "publish:from-dist": "task publish:from-dist"
  },
  "devDependencies": {
    "@zajno/eslint-config": "*"
  },
  "files": [
    "*",
    "LICENSE",
    "!.DS_Store",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./api": "./src/api/index.ts",
    "./api/extensions": "./src/api/extensions/index.ts",
    "./async": "./src/async/index.ts",
    "./dates": "./src/dates/index.ts",
    "./fields": "./src/fields/index.ts",
    "./functions": "./src/functions/index.ts",
    "./lazy": "./src/lazy/index.ts",
    "./lazy/extensions": "./src/lazy/extensions/index.ts",
    "./localization": "./src/localization/index.ts",
    "./logger": "./src/logger/index.ts",
    "./logger/buffered": "./src/logger/buffered/index.ts",
    "./logger/buffered/file": "./src/logger/buffered/file/index.ts",
    "./math": "./src/math/index.ts",
    "./math/object": "./src/math/object/index.ts",
    "./storage": "./src/storage/index.ts",
    "./structures/path": "./src/structures/path/index.ts",
    "./structures/path/utils": "./src/structures/path/utils/index.ts",
    "./structures/promiseCache": "./src/structures/promiseCache/index.ts",
    "./structures/promiseCache/extensions": "./src/structures/promiseCache/extensions/index.ts",
    "./types": "./src/types/index.ts",
    "./validation": "./src/validation/index.ts"
  }
}
