{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ESNext"],
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strict": true,
        "composite": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["*.ts"]
}
