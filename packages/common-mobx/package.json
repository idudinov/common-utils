{
  "name": "@zajno/common-mobx",
  "version": "2.0.0",
  "description": "Zajno's re-usable utilities for JS/TS projects using MobX",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idudinov/common-utils.git",
    "directory": "packages/common-mobx"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "author": "Zajno <hello@zajno.com> (https://zajno.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/idudinov/common-utils/issues"
  },
  "homepage": "https://github.com/idudinov/common-utils/tree/main/packages/common-mobx#readme",
  "scripts": {
    "clean": "scripty",
    "dev": "scripty",
    "build": "scripty",
    "build:clean": "scripty",
    "build:w": "scripty",
    "publish:local": "scripty",
    "publish:from-dist": "scripty",
    "build:full": "scripty",
    "bundle": "scripty",
    "update-exports": "scripty",
    "lint": "scripty",
    "test": "scripty",
    "check": "scripty",
    "check:publish": "scripty"
  },
  "config": {
    "scripty": {
      "path": "../scripts"
    }
  },
  "devDependencies": {
    "@zajno/common": "*",
    "@zajno/eslint-config": "*",
    "mobx": "^6.16.1"
  },
  "peerDependencies": {
    "@zajno/common": "^3",
    "mobx": "^6.13"
  },
  "files": [
    "*",
    "LICENSE",
    "!.DS_Store",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./localization": "./src/localization/index.ts",
    "./viewModels": "./src/viewModels/index.ts"
  }
}
