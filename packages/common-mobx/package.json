{
  "name": "@zajno/common-mobx",
  "version": "2.0.0",
  "description": "Zajno's re-usable utilities for JS/TS projects using MobX",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idudinov/common-utils.git",
    "directory": "packages/common-mobx"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "author": "Zajno <hello@zajno.com> (https://zajno.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/idudinov/common-utils/issues"
  },
  "homepage": "https://github.com/idudinov/common-utils/tree/main/packages/common-mobx#readme",
  "scripts": {
    "clean": "task clean",
    "dev": "task dev",
    "build": "task build",
    "build:clean": "task build:clean",
    "build:full": "task build:full",
    "bundle": "task bundle",
    "update-exports": "task update-exports",
    "lint": "task lint",
    "test": "task test",
    "check": "task check",
    "check:publish": "task check:publish",
    "publish:local": "task publish:local",
    "publish:from-dist": "task publish:from-dist"
  },
  "devDependencies": {
    "@zajno/common": "*",
    "@zajno/eslint-config": "*",
    "mobx": "^6.16.1"
  },
  "peerDependencies": {
    "@zajno/common": "^3.1",
    "mobx": "^6.13"
  },
  "files": [
    "*",
    "LICENSE",
    "!.DS_Store",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./localization": "./src/localization/index.ts",
    "./viewModels": "./src/viewModels/index.ts"
  }
}
