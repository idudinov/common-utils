{
  "name": "@zajno/common-firebase",
  "version": "5.0.0",
  "description": "Zajno's re-usable Firebase utilities for JS/TS projects",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idudinov/common-utils.git",
    "directory": "packages/common-firebase"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "Zajno <hello@zajno.com> (https://zajno.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/idudinov/common-utils/issues"
  },
  "homepage": "https://github.com/idudinov/common-utils/tree/main/packages/common-firebase#readme",
  "scripts": {
    "clean": "task clean",
    "dev": "task dev",
    "build": "task build",
    "build:clean": "task build:clean",
    "build:full": "task build:full",
    "bundle": "task bundle",
    "update-exports": "task update-exports",
    "lint": "task lint",
    "test": "task test",
    "check": "task check",
    "check:publish": "task check:publish",
    "publish:local": "task publish:local",
    "publish:from-dist": "task publish:from-dist"
  },
  "devDependencies": {
    "@firebase/app-types": "^0.9.5",
    "@google-cloud/pubsub": "^6.0.1",
    "@types/express": "^5.0.6",
    "@zajno/common": "*",
    "@zajno/common-mobx": "*",
    "@zajno/eslint-config": "*",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "mobx": "^6.16.1"
  },
  "peerDependencies": {
    "@google-cloud/pubsub": "^5.3 || ^6.0.1",
    "@zajno/common": "^3.1",
    "@zajno/common-mobx": "^2.1",
    "firebase": "^11.6 || ^12.8",
    "firebase-admin": "^12.7 || ^13.6 || ^14.2",
    "firebase-functions": "^7.3",
    "mobx": "^6.15"
  },
  "peerDependenciesMeta": {
    "@google-cloud/pubsub": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "firebase-functions": {
      "optional": true
    }
  },
  "files": [
    "*",
    "LICENSE",
    "!.DS_Store",
    "!*.tsbuildinfo"
